NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://localhost:27017/foodman

CORS_ORIGIN=http://localhost:3000,https://food-man-lilac.vercel.app

JWT_SECRET=foodman-super-secret-jwt-key-2026-production-ready
JWT_EXPIRES_IN=30d

# Pusher Channels Configuration
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=ap2

# Email / SMTP Configuration (for password reset verification codes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com
SMTP_REPLY_TO=your_email@gmail.com
